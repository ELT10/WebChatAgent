# Core
OPENAI_API_KEY=sk-...
BASE_URL=https://sreesuryaayurveda.com

# Chat model
CHAT_MODEL=gpt-5-nano
FALLBACK_CHAT_MODEL=gpt-5-mini
TEMPERATURE=0.7
MAX_HISTORY_TOKENS=2000

# Retrieval & Compression
RETRIEVAL_K=3
ENABLE_COMPRESSION=true

# Caching
ENABLE_CACHING=true
CACHE_TTL_HOURS=24

# Embeddings (local for zero cost; switch to openai if preferred)
EMBEDDING_TYPE=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AI Content Enhancement (NEW - cleans and structures scraped content)
# Enable/disable AI-powered content enhancement (costs ~$0.25-0.50 per website)
ENABLE_AI_ENHANCEMENT=true
# Model to use for enhancement (gpt-4o-mini is recommended for best cost/quality)
ENHANCEMENT_MODEL=gpt-4o-mini
